# Copy to .env for local runs. Never commit .env.
# Directory of the built front end to serve; unset in local dev (Vite serves it).
STATIC_DIR=
# Foundry resource endpoint, for example https://<name>.cognitiveservices.azure.com/
# Auth is keyless (Entra ID): az login locally, managed identity on Azure. There are no API keys.
FOUNDRY_ENDPOINT=
# Foundry deployment for the manager agent (default gpt-5.4-mini, see docs/decisions/0001-models.md).
MANAGER_MODEL=
# Foundry deployment for the host agent (default gpt-5.4-mini, same decision record).
HOST_MODEL=
# Set to 1 only behind a proxy that appends the caller's address to X-Forwarded-For (Container Apps does).
TRUST_PROXY=
