{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match-meta.schema.json",
  "title": "MatchMeta",
  "description": "Sent once when a session starts. All clubs and players are invented (rule 4.7).",
  "type": "object",
  "required": ["match_id", "seed", "speed", "home", "away"],
  "additionalProperties": false,
  "properties": {
    "match_id": { "type": "string", "pattern": "^match_[a-z0-9_]+$" },
    "fixture_id": {
      "description": "Set on each fixture of a gameweek message; absent on a single match's meta.",
      "$ref": "common.schema.json#/$defs/fixtureId"
    },
    "seed": { "type": "integer", "minimum": 0 },
    "speed": { "description": "Match seconds per real second. The plan uses 30.", "type": "number", "exclusiveMinimum": 0 },
    "playback_delay_ms": {
      "description": "Real milliseconds the screens run behind the simulator: the broadcast delay the agents work inside.",
      "type": "integer",
      "minimum": 0
    },
    "home": { "$ref": "#/$defs/team" },
    "away": { "$ref": "#/$defs/team" }
  },
  "$defs": {
    "team": {
      "type": "object",
      "required": ["id", "name", "short_name", "colour", "formation", "players"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/teamId" },
        "name": { "type": "string", "maxLength": 40 },
        "short_name": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "formation": { "type": "string", "pattern": "^[0-9](-[0-9]){2,3}$" },
        "players": {
          "type": "array",
          "minItems": 11,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "name", "shirt", "position"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/playerId" },
              "name": { "type": "string", "maxLength": 40 },
              "shirt": { "type": "integer", "minimum": 1, "maximum": 99 },
              "position": { "enum": ["GK", "DEF", "MID", "FWD"] },
              "starter": { "type": "boolean", "default": true }
            }
          }
        }
      }
    }
  }
}
